# Připojení k Neon Postgres (projekt zdravi-bliz-lidem, databáze zdravko)
DATABASE_URL=postgresql://user:password@host/zdravko?sslmode=require
# Náhodný řetězec (aspoň 32 znaků) pro podpis session cookie
SESSION_SECRET=

# Resend (potvrzení veřejných připomínek); bez klíče se e-maily neposílají
RESEND_API_KEY=
MAIL_FROM=Zdraví blíž lidem <pripominky@example.cz>
# Adresa webu pro odkazy v e-mailech, náhledy a sitemap (bez ní https://www.zdraviblizlidem.cz)
NEXT_PUBLIC_SITE_URL=https://www.zdraviblizlidem.cz
# Ověření webu ve vyhledávačích: jen hodnota z meta značky (content="…"), ne celá značka.
GOOGLE_SITE_VERIFICATION=
SEZNAM_SITE_VERIFICATION=

# Ochrana údajů: klíč pro HMAC adres IP a odkazy na vlastní údaje (bez něj se použije SESSION_SECRET),
# kontakt na stránce /ochrana-udaju a tajemství, kterým Vercel volá denní /cron/retence
PRIVACY_SECRET=
PRIVACY_CONTACT=pripominky@example.cz
CRON_SECRET=
# Kam poslat upozornění na novou potvrzenou veřejnou připomínku (nepovinné)
COMMENT_NOTIFY_TO=

# Odběr novinek (Brevo): API klíč; seznam „Zdraví blíž lidem — novinky“ web najde nebo založí sám,
# číslo seznamu lze pevně zadat
BREVO_API_KEY=
BREVO_LIST_ID=
