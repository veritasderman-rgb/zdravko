# Připojení k Neon Postgres (projekt zdravi-bliz-lidem, databáze zdravko)
DATABASE_URL=postgresql://user:password@host/zdravko?sslmode=require
# Jediný přístupový kód pro interní fázi (do dodání seznamu členů RT)
ACCESS_CODE=
# Náhodný řetězec (aspoň 32 znaků) pro podpis session cookie
SESSION_SECRET=
